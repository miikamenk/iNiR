// ─────────────────────────────────────────────────────────────────────────────
// 60 — Animations
// ─────────────────────────────────────────────────────────────────────────────
// Docs: https://niri-wm.github.io/niri/Configuration:-Animations
//
// iNiR uses crafted per-interaction motion instead of one-size-fits-all:
//
//   - Windows OPEN with a hint of overshoot (welcoming, physical).
//   - Windows CLOSE with a quick, clean fade (no chaotic poof).
//   - Direct-manipulation motion (drag, resize, view scroll) is critically
//     damped — it tracks your input precisely with zero wobble.
//   - Workspace switches glide with a touch of fluidity.
//
// Spring parameters:
//
//   damping-ratio  How quickly the spring settles.
//                  < 1.0 = bouncy / oscillates
//                  = 1.0 = critically damped (settles fastest, no overshoot)
//                  > 1.0 = overdamped (slow, sluggish stop)
//
//   stiffness      How "snappy" the spring is. Higher = faster movement.
//
//   epsilon        Threshold to consider the animation "done" (0.0001 is fine).
//
// You can also use duration-based easing instead of springs:
//   duration-ms 250 curve "ease-out-expo"
// ─────────────────────────────────────────────────────────────────────────────

animations {
    // Uncomment to disable all animations globally (GameMode toggles this line).
    // Values below 1.0 speed them up. Default: 1.0
    // slowdown 3.0
    //off

    // ── Workspace transitions ───────────────────────────────────────────────
    // Fluid glide with a barely-there settle.
    workspace-switch {
        spring damping-ratio=0.95 stiffness=280 epsilon=0.0001
    }

    // ── Window lifecycle ────────────────────────────────────────────────────
    // Opens with a hint of overshoot — welcoming, physical.
    window-open {
        spring damping-ratio=0.90 stiffness=350 epsilon=0.0001
    }

    // Quick, clean exit — no chaotic poof.
    window-close {
        duration-ms 150
        curve "ease-out-expo"
    }

    // ── Layout movement (direct manipulation: critically damped) ────────────
    // Scrolling the horizontal strip when you focus a different column.
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=400 epsilon=0.0001
    }

    // Dragging or moving a window between columns/workspaces.
    // Tracks the pointer tightly — any bounce here feels broken.
    window-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }

    // Interactive column/window resize.
    window-resize {
        spring damping-ratio=1.0 stiffness=400 epsilon=0.0001
    }

    // ── UI chrome ───────────────────────────────────────────────────────────
    // The "config saved" toast that appears after editing this file.
    config-notification-open-close {
        spring damping-ratio=0.90 stiffness=500 epsilon=0.0001
    }

    // Niri's built-in screenshot UI opening.
    screenshot-ui-open {
        spring damping-ratio=0.90 stiffness=500 epsilon=0.0001
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    recent-windows-close {
        duration-ms 160
        curve "ease-out-quad"
    }
}
